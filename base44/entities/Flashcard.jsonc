{
  "name": "Flashcard",
  "type": "object",
  "properties": {
    "set_id": {
      "type": "string",
      "description": "ID of the flashcard set this card belongs to"
    },
    "term": {
      "type": "string",
      "description": "Front of the card (term/question)"
    },
    "definition": {
      "type": "string",
      "description": "Back of the card (definition/answer)"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Order of the card in the set"
    },
    "times_correct": {
      "type": "number",
      "default": 0
    },
    "times_incorrect": {
      "type": "number",
      "default": 0
    },
    "last_reviewed": {
      "type": "string",
      "format": "date-time"
    },
    "mastery_level": {
      "type": "number",
      "default": 0,
      "description": "0-100 mastery percentage"
    }
  },
  "required": [
    "set_id",
    "term",
    "definition"
  ]
}